{
  "name": "mergepilot-monorepo",
  "version": "0.5.24",
  "description": "Local-first AI workspace for pull requests, repository context, Azure DevOps, and delivery workflows.",
  "private": true,
  "author": "ZP151 <zhouping151140@gmail.com>",
  "contributors": [
    "ZP151 <zhouping151140@gmail.com>"
  ],
  "homepage": "https://github.com/ZP151/MergePilot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZP151/MergePilot.git"
  },
  "bugs": {
    "url": "https://github.com/ZP151/MergePilot/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "pnpm -r --filter=./packages/* run test",
    "lint": "pnpm -r --filter=./packages/* run lint",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "tui": "tsx packages/cli/src/bin.ts tui",
    "dev:daemon": "pnpm --filter @mergepilot/daemon run dev",
    "dev:cli": "pnpm --filter @mergepilot/cli run dev",
    "e2e:chat": "playwright test tests/e2e/chat-layout.spec.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,json,md}\""
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
