{
  "name": "@mergepilot/core",
  "version": "0.5.27",
  "description": "MergePilot core planner, tool, repository context, and Azure DevOps runtime.",
  "private": true,
  "author": "ZP151 <zhouping151140@gmail.com>",
  "homepage": "https://github.com/ZP151/MergePilot#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZP151/MergePilot.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chatContext": {
      "types": "./dist/chatContext.d.ts",
      "import": "./dist/chatContext.js"
    },
    "./db/schema.sql": "./src/db/schema.sql"
  },
  "files": [
    "dist",
    "src/db/schema.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.0",
    "@azure/data-tables": "^13.3.0",
    "@azure/identity": "^4.4.0",
    "@azure/identity-cache-persistence": "^1.2.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/msal-node": "^5.2.1",
    "@azure/msal-node-extensions": "^5.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "applicationinsights": "^3.2.0",
    "better-sqlite3": "^11.2.0",
    "fast-glob": "^3.3.2",
    "keytar": "^7.9.0",
    "open": "^10.2.0",
    "openai": "^4.65.0",
    "pino": "^9.4.0",
    "sqlite-vec": "^0.1.6",
    "web-tree-sitter": "^0.23.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
